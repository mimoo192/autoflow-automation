{
  "name": "Shopify Order → Digital Product Delivery",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "created_at",
              "operation": "after",
              "value": "{{ $now.minus(5, 'minutes').toISO() }}"
            }
          ]
        }
      },
      "id": "1",
      "name": "Shopify Trigger (New Order)",
      "type": "n8n-nodes-base.shopifyTrigger",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "webhookId": "shopify-order-webhook",
      "credentials": {
        "shopifyApi": "shopify-credentials"
      }
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.line_items[0].fulfillment_service === 'digital' || $json.line_items[0].product_type === 'Digital' }}",
              "operation": "true"
            }
          ]
        }
      },
      "id": "2",
      "name": "Filter Digital Products Only",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "functionCode": "const lineItems = $json.line_items;\nconst digitalItems = lineItems.filter(item => \n  item.fulfillment_service === 'digital' || item.product_type === 'Digital'\n);\n\nreturn digitalItems.map(item => ({\n  orderId: $json.id,\n  orderNumber: $json.order_number,\n  customerEmail: $json.email,\n  customerName: `${$json.billing_address.first_name} ${$json.billing_address.last_name}`,\n  productTitle: item.title,\n  productHandle: item.handle || item.title.toLowerCase().replace(/\\s+/g, '-'),\n  quantity: item.quantity,\n  price: item.price,\n  sku: item.sku\n}));"
      },
      "id": "3",
      "name": "Extract Digital Line Items",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        750,
        200
      ]
    },
    {
      "parameters": {
        "operation": "get",
        "filePath": "=/digital-products/{{$json.productHandle}}.zip",
        "options": {}
      },
      "id": "4",
      "name": "Get Digital File from Google Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 2,
      "position": [
        1000,
        100
      ],
      "credentials": {
        "googleDriveOAuth2Api": "google-drive-credentials"
      }
    },
    {
      "parameters": {
        "fromEmail": "noreply@yourstore.com",
        "toEmail": "={{$json.customerEmail}}",
        "subject": "Your Digital Download: {{$json.productTitle}}",
        "text": "Hi {{$json.customerName}},\n\nThank you for your order #{{$json.orderNumber}}!\n\nYour digital product **{{$json.productTitle}}** is ready for download.\n\nDownload link: {{ $node[\"Upload to Google Drive\"].json.webViewLink }}\n\nThis link expires in 7 days. If you have any issues, please reply to this email.\n\nBest regards,\nThe Team",
        "html": "<p>Hi {{$json.customerName}},</p><p>Thank you for your order #{{$json.orderNumber}}!</p><p>Your digital product <strong>{{$json.productTitle}}</strong> is ready for download.</p><p><a href=\"{{ $node[\"Upload to Google Drive\"].json.webViewLink }}\">Download your file</a></p><p>This link expires in 7 days. If you have any issues, please reply to this email.</p><p>Best regards,<br>The Team</p>",
        "options": {
          "attachments": [
            {
              "fileName": "={{$json.productTitle}}.zip",
              "fileContent": "={{$node[\"Get Digital File from Google Drive\"].json.fileContent}}",
              "contentType": "application/zip"
            }
          ]
        }
      },
      "id": "5",
      "name": "Send Delivery Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [
        1250,
        200
      ],
      "credentials": {
        "gmailOAuth2Api": "gmail-credentials"
      }
    },
    {
      "parameters": {
        "operation": "update",
        "fileId": "={{$node[\"Get Digital File from Google Drive\"].json.id}}",
        "updateFields": {
          "addParents": [],
          "removeParents": []
        },
        "options": {}
      },
      "id": "6",
      "name": "Mark File as Delivered (Move to Delivered Folder)",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 2,
      "position": [
        1000,
        300
      ],
      "credentials": {
        "googleDriveOAuth2Api": "google-drive-credentials"
      }
    },
    {
      "parameters": {
        "functionCode": "console.log('Order fulfilled:', $json.orderNumber);\nreturn [{ json: { success: true, orderNumber: $json.orderNumber, delivered: true } }];"
      },
      "id": "7",
      "name": "Log Success",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        1500,
        200
      ]
    },
    {
      "parameters": {
        "functionCode": "const error = $json.error;\nconsole.error('Delivery failed:', error);\n\nreturn [{ json: { success: false, error: error.message, orderNumber: $json.orderNumber } }];"
      },
      "id": "8",
      "name": "Error Handler",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        1500,
        400
      ]
    }
  ],
  "connections": {
    "Shopify Trigger (New Order)": {
      "main": [
        [
          {
            "node": "Filter Digital Products Only",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter Digital Products Only": {
      "main": [
        [
          {
            "node": "Extract Digital Line Items",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Error Handler",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Digital Line Items": {
      "main": [
        [
          {
            "node": "Get Digital File from Google Drive",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Digital File from Google Drive": {
      "main": [
        [
          {
            "node": "Send Delivery Email",
            "type": "main",
            "index": 0
          },
          {
            "node": "Mark File as Delivered (Move to Delivered Folder)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Delivery Email": {
      "main": [
        [
          {
            "node": "Log Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Mark File as Delivered (Move to Delivered Folder)": {
      "main": [
        [
          {
            "node": "Log Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": true,
    "instanceId": "shopify-digital-delivery"
  },
  "id": "shopify-digital-delivery"
}